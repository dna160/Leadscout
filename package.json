{
  "name": "leadscout-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:engine": "pnpm --filter @leadscout/engine dev",
    "dev:dashboard": "pnpm --filter @leadscout/dashboard dev",
    "build:engine": "pnpm --filter @leadscout/engine build",
    "build:dashboard": "pnpm --filter @leadscout/dashboard build",
    "migrate": "pnpm --filter @leadscout/engine migrate",
    "test": "pnpm --filter @leadscout/engine test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
